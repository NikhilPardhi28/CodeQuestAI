  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "correlationId": {
            "type": "string",
            "title": "Correlationid"
          },
          "currentState": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currentstate"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "title": "ApiError"
      },
      "Page_QuestProgressV2Out_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/QuestProgressV2Out"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Offset"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset",
          "total"
        ],
        "title": "Page[QuestProgressV2Out]"
      },
      "ProgressionOut": {
        "properties": {
          "experience": {
            "type": "integer",
            "title": "Experience"
          },
          "level": {
            "type": "integer",
            "title": "Level"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "experience",
          "level",
          "revision",
          "updatedAt"
        ],
        "title": "ProgressionOut"
      },
      "QuestDefinitionV2Out": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "objectiveRules": {
            "items": {
              "$ref": "#/components/schemas/QuestObjectiveRuleOut"
            },
            "type": "array",
            "title": "Objectiverules"
          },
          "prerequisiteQuestIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prerequisitequestids"
          },
          "rewards": {
            "items": {
              "$ref": "#/components/schemas/QuestRewardRuleOut"
            },
            "type": "array",
            "title": "Rewards"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "version",
          "title",
          "summary",
          "objectiveRules",
          "prerequisiteQuestIds",
          "rewards"
        ],
        "title": "QuestDefinitionV2Out"
      },
      "QuestEventRequest": {
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "title": "Eventid"
          },
          "questVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Questversion"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "interact",
              "checkpoint",
              "challenge_passed",
              "prerequisite_completed"
            ],
            "title": "Eventtype"
          },
          "targetId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Targetid"
          },
          "targetVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Targetversion",
            "default": 1
          },
          "challengeSubmissionId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challengesubmissionid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "eventId",
          "questVersion",
          "expectedRevision",
          "eventType",
          "targetId"
        ],
        "title": "QuestEventRequest"
      },
      "QuestEventResult": {
        "properties": {
          "questSlug": {
            "type": "string",
            "title": "Questslug"
          },
          "questVersion": {
            "type": "integer",
            "title": "Questversion"
          },
          "status": {
            "type": "string",
            "enum": [
              "locked",
              "available",
              "in_progress",
              "completed",
              "abandoned"
            ],
            "title": "Status"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "objectiveProgress": {
            "items": {
              "$ref": "#/components/schemas/QuestObjectiveProgressOut"
            },
            "type": "array",
            "title": "Objectiveprogress"
          },
          "newlyGrantedRewards": {
            "items": {
              "$ref": "#/components/schemas/QuestEventRewardOut"
            },
            "type": "array",
            "title": "Newlygrantedrewards"
          },
          "progression": {
            "$ref": "#/components/schemas/ProgressionOut"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "questSlug",
          "questVersion",
          "status",
          "revision",
          "objectiveProgress",
          "newlyGrantedRewards",
          "progression"
        ],
        "title": "QuestEventResult"
      },
      "QuestEventRewardOut": {
        "properties": {
          "rewardId": {
            "type": "string",
            "title": "Rewardid"
          },
          "rewardType": {
            "type": "string",
            "const": "experience",
            "title": "Rewardtype"
          },
          "experiencePoints": {
            "type": "integer",
            "title": "Experiencepoints"
          }
        },
        "type": "object",
        "required": [
          "rewardId",
          "rewardType",
          "experiencePoints"
        ],
        "title": "QuestEventRewardOut"
      },
      "QuestObjectiveProgressOut": {
        "properties": {
          "objectiveId": {
            "type": "string",
