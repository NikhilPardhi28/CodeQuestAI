          },
          "completedCount": {
            "type": "integer",
            "title": "Completedcount"
          },
          "requiredCount": {
            "type": "integer",
            "title": "Requiredcount"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          }
        },
        "type": "object",
        "required": [
          "objectiveId",
          "completedCount",
          "requiredCount",
          "completed"
        ],
        "title": "QuestObjectiveProgressOut"
      },
      "QuestObjectiveRuleOut": {
        "properties": {
          "objectiveId": {
            "type": "string",
            "title": "Objectiveid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "interact",
              "checkpoint",
              "challenge_passed",
              "prerequisite_completed"
            ],
            "title": "Eventtype"
          },
          "targetId": {
            "type": "string",
            "title": "Targetid"
          },
          "targetVersion": {
            "type": "integer",
            "title": "Targetversion"
          },
          "requiredCount": {
            "type": "integer",
            "title": "Requiredcount"
          },
          "prerequisiteObjectiveIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prerequisiteobjectiveids"
          }
        },
        "type": "object",
        "required": [
          "objectiveId",
          "eventType",
          "targetId",
          "targetVersion",
          "requiredCount",
          "prerequisiteObjectiveIds"
        ],
        "title": "QuestObjectiveRuleOut"
      },
      "QuestProgressV2Out": {
        "properties": {
          "questSlug": {
            "type": "string",
            "title": "Questslug"
          },
          "questVersion": {
            "type": "integer",
            "title": "Questversion"
          },
          "status": {
            "type": "string",
            "enum": [
              "locked",
              "available",
              "in_progress",
              "completed",
              "abandoned"
            ],
            "title": "Status"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "objectiveProgress": {
            "items": {
              "$ref": "#/components/schemas/QuestObjectiveProgressOut"
            },
            "type": "array",
            "title": "Objectiveprogress"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "questSlug",
          "questVersion",
          "status",
          "revision",
          "objectiveProgress",
          "createdAt",
          "updatedAt"
        ],
        "title": "QuestProgressV2Out"
      },
      "QuestRewardRuleOut": {
        "properties": {
          "rewardId": {
            "type": "string",
            "title": "Rewardid"
          },
          "rewardType": {
            "type": "string",
            "const": "experience",
            "title": "Rewardtype"
          },
          "experiencePoints": {
            "type": "integer",
            "title": "Experiencepoints"
          }
        },
        "type": "object",
        "required": [
          "rewardId",
          "rewardType",
          "experiencePoints"
        ],
        "title": "QuestRewardRuleOut"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
