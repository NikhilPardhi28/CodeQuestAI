# Copy to .env for local use. Replace placeholders locally; never commit .env.
CODEQUEST_ENV=local
CODEQUEST_LOG_LEVEL=INFO
CODEQUEST_POSTGRES_PASSWORD=change-me-local-only
CODEQUEST_DATABASE_URL=postgresql+psycopg://codequest:change-me-local-only@localhost:5432/codequest
# Optional: enable submissions only after the separate worker is running.
# CODEQUEST_EVALUATION_WORKER_URL=http://127.0.0.1:8100
# Generate a unique local secret; never commit a real token.
# CODEQUEST_EVALUATION_WORKER_TOKEN=replace-with-a-long-random-local-secret
CODEQUEST_EVALUATION_QUEUE_LIMIT=500
CODEQUEST_SUBMISSION_SOURCE_RETENTION_DAYS=30
# Set only in the worker environment to a reviewed immutable image digest:
# CODEQUEST_EVALUATOR_IMAGE=registry.example/codequest-evaluator@sha256:<reviewed-digest>
# Optional external AI credentials belong only in local secret storage, never here or in source.
# Set all three only after configuring a real OIDC issuer; otherwise player routes stay disabled:
# CODEQUEST_AUTH_ISSUER=https://your-issuer.example/
# CODEQUEST_AUTH_AUDIENCE=codequest-api
# CODEQUEST_AUTH_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
